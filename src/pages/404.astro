---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="这一页不存在">
  <div class="wrap notfound">
    <p class="notfound__code mono">四〇四 · 未收录</p>
    <h1 class="notfound__title">
      <span class="glitch" data-text="这一页还没写">这一页还没写</span>
    </h1>
    <p class="notfound__text">
      你要找的内容不在记事本里。<br />
      可能是链接写错了，也可能是我还没记到这一页。
    </p>
    <p class="notfound__actions">
      <a class="btn btn--primary" href="/">返回首页</a>
      <a class="btn btn--ghost" href="/posts">翻翻文章</a>
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: 100px 24px;
    text-align: center;
  }

  .notfound__code {
    margin: 0 0 16px;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--neon-ember);
    text-shadow: var(--glow-orange);
  }

  .notfound__title {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(34px, 8vw, 64px);
    font-weight: 900;
    letter-spacing: 0.04em;
    background: linear-gradient(100deg, #7c2d12, #92400e 55%, #78350f);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 24px rgba(156, 61, 46, 0.5));
  }

  .notfound__text {
    margin: 0 0 34px;
    font-size: 15.5px;
    line-height: 2;
    color: var(--text-muted);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 0;
  }
</style>
