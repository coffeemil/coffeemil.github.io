---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const skills = [
  { name: 'Agent 架构设计', level: 92 },
  { name: 'LLM 应用 / RAG', level: 90 },
  { name: 'Tool Use / MCP', level: 88 },
  { name: 'Prompt / Context 工程', level: 86 },
  { name: 'TypeScript / Node.js', level: 88 },
  { name: '评测 / 可观测性', level: 82 },
];

const attributes = [
  { key: 'CLASS', value: 'Agent Developer' },
  { key: 'RANK', value: '像素记事本' },
  { key: 'ELEMENT', value: 'LLM / TypeScript' },
  { key: 'GUILD', value: 'Agent 边界' },
  { key: 'WEAKNESS', value: '深夜的 bug' },
  { key: 'STATUS', value: 'ONLINE' },
];
---

<BaseLayout title="关于" description={`关于 ${SITE.author} —— Agent 开发工程师 / 像素记事本`}>
  <div class="wrap wrap--narrow about">
    <header class="about__hero">
      <p class="about__kicker mono">「关 于」</p>
      <h1 class="about__title">{SITE.epithet}</h1>
      <p class="about__byline mono">by {SITE.title}</p>
      <p class="about__intro">
        你好，我是 <strong>{SITE.author}</strong>，一名 Agent 开发工程师。
        白天调教智能体，晚上写一些没人要求但自己很想做的东西 ——
        比如这个博客
      </p>
    </header>

    <!-- 属性面板 -->
    <section class="about__section reveal">
      <h2 class="about__heading mono">「身 份」</h2>
      <dl class="attrs panel">
        {
          attributes.map((a) => (
            <div class="attrs__row">
              <dt class="attrs__key mono">{a.key}</dt>
              <dd class="attrs__value">{a.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 技能 -->
    <section class="about__section reveal">
      <h2 class="about__heading mono">「能 力」</h2>
      <ul class="skills">
        {
          skills.map((s) => (
            <li class="skill">
              <div class="skill__head">
                <span class="skill__name">{s.name}</span>
                <span class="skill__level mono">{s.level}</span>
              </div>
              <div class="skill__track">
                <span class="skill__fill" style={`--w:${s.level}%`} />
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: 56px;
  }

  .about__hero {
    text-align: center;
    margin-bottom: 56px;
  }

  .about__kicker {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--neon-amber);
  }

  .about__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 46px);
    font-weight: 900;
    letter-spacing: 0.08em;
    background: linear-gradient(100deg, #7c2d12, #92400e 55%, #78350f);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 22px rgba(156, 61, 46, 0.5));
  }

  .about__byline {
    margin: 0 0 24px;
    font-size: 12.5px;
    letter-spacing: 0.16em;
    color: var(--text-dim);
  }

  .about__intro {
    max-width: 560px;
    margin: 0 auto;
    font-size: 15.5px;
    line-height: 1.95;
    color: var(--text-secondary);
  }

  .about__intro strong {
    color: var(--neon-gold);
  }

  .about__section {
    margin-bottom: 48px;
  }

  .about__heading {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--neon-gold);
  }

  /* ---------- 属性 ---------- */
  .attrs {
    margin: 0;
    padding: 8px 22px;
  }

  .attrs__row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 11px 0;
    border-bottom: 1px dashed rgba(156, 61, 46, 0.14);
  }

  .attrs__row:last-child {
    border-bottom: none;
  }

  .attrs__key {
    flex: none;
    width: 110px;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--neon-amber);
  }

  .attrs__value {
    margin: 0;
    font-size: 15px;
    color: var(--text-primary);
  }

  /* ---------- 技能 ---------- */
  .skills {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 7px;
  }

  .skill__name {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .skill__level {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--neon-gold);
  }

  .skill__track {
    height: 6px;
    border-radius: 999px;
    background: rgba(156, 61, 46, 0.12);
    overflow: hidden;
  }

  .skill__fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--neon-amber), var(--neon-gold));
    box-shadow: 0 0 12px rgba(124, 45, 18, 0.6);
    transform-origin: left;
    animation: skill-grow 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes skill-grow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill__fill { animation: none; }
  }
</style>
