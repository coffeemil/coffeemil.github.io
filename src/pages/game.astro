---
import BaseLayout from '../layouts/BaseLayout.astro';

const specs = [
  { key: 'ENGINE', value: '原生 Canvas 2D' },
  { key: 'LANGUAGE', value: 'TypeScript' },
  { key: 'SIZE', value: '单文件 · 零依赖' },
  { key: 'PLATFORM', value: '桌面 / 移动端' },
  { key: 'CONTROL', value: '按住刹车 · 松手加速' },
  { key: 'THRESHOLD', value: '1612' },
];

/** 游戏线上地址（已部署至 Vercel） */
const PLAY_URL = 'https://redline-1612n.vercel.app/';

const mechanics = [
  {
    title: '刹车力度',
    text: '按住屏幕时刹车力度非线性上升，0 → 1612 约需 0.46 秒；松手后以更快的速度冷却。',
  },
  {
    title: '断裂阈值',
    text: '刹车力度一旦突破 1612，刹车就会断裂 —— 之后你只能眼睁睁看着车冲进弯道。',
  },
  {
    title: '弯道计数',
    text: '每安全通过一个弯道计数 +1。速度越快，弯道来得越急，留给你的反应窗口越窄。',
  },
];
---

<BaseLayout title="Redline1612N" description="Redline1612N —— 一个用原生 Canvas 手写的赛车小游戏">
  <div class="wrap game-page">
    <header class="game-hero">
      <p class="game-hero__kicker mono">「个 人 作 品 · CANVAS」</p>
      <h1 class="game-hero__title">
        <span class="glitch" data-text="Redline1612N">Redline1612N</span>
      </h1>
      <p class="game-hero__sub mono">REDLINE 1612N</p>
      <p class="game-hero__desc">
        按住屏幕刹车，松手加速。刹车力度超过 <strong>1612</strong> 就会断裂 ——
        在弯道与极限之间，寻找那条唯一的生路。
      </p>
      <p class="game-hero__license mono">
        ※ 个人作品 · 保留所有权利
      </p>
    </header>

    <!-- 试玩入口 -->
    <section class="play reveal">
      <a
        class="play__cta"
        href={PLAY_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="play__cta-label">即刻试玩</span>
        <svg
          class="play__cta-icon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>

      <p class="play__hint mono">
        在新标签页打开 · 桌面端按住鼠标 / 移动端按住屏幕刹车
      </p>
    </section>

    <!-- 玩法 -->
    <section class="game-section reveal">
      <h2 class="game-section__title mono">「玩 法」</h2>
      <div class="mechanics">
        {
          mechanics.map((m, i) => (
            <article class="mechanic panel panel--hover">
              <span class="mechanic__num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mechanic__title">{m.title}</h3>
              <p class="mechanic__text">{m.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 技术参数 -->
    <section class="game-section reveal">
      <h2 class="game-section__title mono">「参 数」</h2>
      <dl class="specs panel">
        {
          specs.map((s) => (
            <div class="specs__row">
              <dt class="specs__key mono">{s.key}</dt>
              <dd class="specs__value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="game-back">
      <a class="btn btn--ghost" href="/">← 返回首页</a>
    </p>
  </div>
</BaseLayout>

<style>
  .game-page {
    padding-top: 56px;
  }

  /* ---------- HERO ---------- */
  .game-hero {
    text-align: center;
    margin-bottom: 44px;
  }

  .game-hero__kicker {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--neon-amber);
  }

  .game-hero__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(38px, 9vw, 72px);
    font-weight: 900;
    letter-spacing: 0.04em;
    background: linear-gradient(100deg, #7c2d12, #92400e 50%, #78350f 85%, #a16207);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 26px rgba(156, 61, 46, 0.55));
  }

  .game-hero__sub {
    margin: 0 0 20px;
    font-size: 13px;
    letter-spacing: 0.34em;
    color: var(--neon-gold);
    text-shadow: var(--glow-gold);
  }

  .game-hero__desc {
    max-width: 560px;
    margin: 0 auto;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .game-hero__desc strong {
    color: var(--neon-amber);
  }

  .game-hero__license {
    margin: 18px 0 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }

  /* ---------- 试玩入口 ---------- */
  .play {
    margin-bottom: 56px;
    text-align: center;
  }

  .play__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 34px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fdfaf3;
    background: var(--neon-amber);
    border-radius: 999px;
    transition: background 0.22s ease, transform 0.22s ease;
  }

  .play__cta:hover {
    color: #fdfaf3;
    background: var(--neon-orange);
    text-shadow: none;
    transform: translateY(-2px);
  }

  .play__cta-icon {
    flex: none;
    transition: transform 0.22s ease;
  }

  .play__cta:hover .play__cta-icon {
    transform: translate(2px, -2px);
  }

  .play__hint {
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--text-dim);
  }

  /* ---------- 区块 ---------- */
  .game-section {
    margin-bottom: 48px;
  }

  .game-section__title {
    margin: 0 0 20px;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--neon-gold);
  }

  /* ---------- 机制 ---------- */
  .mechanics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .mechanic {
    padding: 22px 24px;
  }

  .mechanic__num {
    display: block;
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 700;
    color: var(--neon-amber);
    text-shadow: var(--glow-amber);
  }

  .mechanic__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .mechanic__text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--text-secondary);
  }

  /* ---------- 参数 ---------- */
  .specs {
    margin: 0;
    padding: 8px 22px;
  }

  .specs__row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 11px 0;
    border-bottom: 1px dashed rgba(156, 61, 46, 0.14);
  }

  .specs__row:last-child {
    border-bottom: none;
  }

  .specs__key {
    flex: none;
    width: 130px;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--neon-amber);
  }

  .specs__value {
    margin: 0;
    font-size: 15px;
    color: var(--text-primary);
  }

  .game-back {
    margin: 0;
    text-align: center;
  }
</style>
