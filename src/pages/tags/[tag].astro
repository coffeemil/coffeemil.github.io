---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`#${tag}`} description={`标签 #${tag} 下的全部文章`}>
  <div class="wrap page-head">
    <p class="page-head__kicker mono">
      <a href="/tags">「标记」</a>
      <span class="page-head__sep">/</span>
      <span>{tag}</span>
    </p>
    <h1 class="page-head__title">#{tag}</h1>
    <p class="page-head__desc">
      共 <strong>{posts.length}</strong> 篇记录
    </p>
  </div>

  <div class="wrap">
    <div class="post-grid">
      {
        posts.map((post, i) => (
          <PostCard
            href={`/posts/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            chunibyo={post.data.chunibyo}
            index={posts.length - i}
          />
        ))
      }
    </div>

    <p class="back">
      <a class="btn btn--ghost" href="/tags">← 返回全部标签</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 56px 24px 40px;
    text-align: center;
  }

  .page-head__kicker {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .page-head__kicker a {
    color: var(--neon-amber);
  }

  .page-head__sep {
    margin: 0 8px;
    color: var(--text-dim);
  }

  .page-head__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(28px, 6vw, 44px);
    font-weight: 900;
    letter-spacing: 0.04em;
    background: linear-gradient(100deg, #7c2d12, #92400e 55%, #78350f);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 20px rgba(156, 61, 46, 0.45));
  }

  .page-head__desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  .page-head__desc strong {
    color: var(--neon-gold);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  .back {
    margin: 44px 0 0;
    text-align: center;
  }
</style>
